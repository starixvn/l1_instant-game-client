  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "node": {
      "__id__": 15
    },
    "_enabled": true,
    "_fontFamily": "Arial",
    "_isSystemFontUsed": true,
    "_N$string": "Winning Conditions\n+ <b>EVEN</b>: if the total red or white buttons having in the result is an Even number.\n+ <b>ODD</b>:  if the total red or white buttons having in the result is an Odd number.\n+ Other bet options as <b>4 Red </b> (<img src=\"dot_red\" offset=-4/><img src=\"dot_red\" offset=-4/><img src=\"dot_red\" offset=-4/><img src=\"dot_red\" offset=-4/>), <b>4 White</b>(<img src=\"dot_white\" offset=-4/><img src=\"dot_white\" offset=-4/><img src=\"dot_white\" offset=-4/><img src=\"dot_white\" offset=-4/>), <b>3 Red </b>(<img src=\"dot_white\" offset=-4/><img src=\"dot_red\" offset=-4/><img src=\"dot_red\" offset=-4/><img src=\"dot_red\" offset=-4/>), <b>1 Red </b>(<img src=\"dot_white\" offset=-4/><img src=\"dot_white\" offset=-4/><img src=\"dot_white\" offset=-4/><img src=\"dot_red\" offset=-4/>): if the outcome matches the player’s bet, the player wins.",
    "_N$horizontalAlign": 0,
    "_N$fontSize": 12,
    "_N$font": null,
    "_N$cacheMode": 2,
    "_N$maxWidth": 342,
    "_N$lineHeight": 18,
