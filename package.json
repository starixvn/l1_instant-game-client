{
    "name": "src",
    "version": "1.0.0",
    "description": "Hello world new project template.",
    "main": "version_generator.js",
    "scripts": {
        "lint": "eslint \"{src,apps,libs,test,assets, packages}/**/*.ts\" --fix",
        "test": "jest --maxWorkers --colors test",
        "format": "prettier --write ./assets",
        "test-coverage": "jest --collect-coverage",
        "build": "javascript-obfuscator ./build --output ./build --exclude cocos2d-js-min"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.12.13",
        "@babel/plugin-proposal-decorators": "^7.12.13",
        "@babel/preset-env": "^7.12.13",
        "@babel/preset-typescript": "^7.12.13",
        "@commitlint/cli": "^13.1.0",
        "@commitlint/config-conventional": "^13.1.0",
        "@types/chance": "^1.1.0",
        "@types/jest": "^26.0.20",
        "@types/lodash": "^4.14.150",
        "@types/lodash.random": "^3.2.6",
        "@types/moment": "^2.13.0",
        "@typescript-eslint/eslint-plugin": "^4.14.2",
        "@typescript-eslint/parser": "3.0.2",
        "babel-jest": "^26.6.3",
        "eslint": "^7.19.0",
        "eslint-config-prettier": "^6.10.0",
        "eslint-plugin-import": "^2.20.1",
        "jest": "^26.6.3",
        "jest-canvas-mock": "^2.3.1",
        "jest-sonar-reporter": "^2.0.0",
        "prettier": "^2.2.1",
        "prettier-eslint": "^12.0.0",
        "prettier-eslint-cli": "^5.0.0",
        "ts-jest": "^26.5.0",
        "typescript": "^4.1.3"
    },
    "dependencies": {
        "axios": "^0.21.1",
        "chance": "^1.1.8",
        "husky": "^7.0.4",
        "i18n": "file:./packages/i18n",
        "inversify": "^5.0.5",
        "inversify-inject-decorators": "^3.1.0",
        "javascript-obfuscator": "2.10.2",
        "lodash": "^4.17.20",
        "moment": "^2.26.0",
        "reflect-metadata": "^0.1.13",
        "sc-user-service-client": "^1.1.0",
        "socket.io-client": "^4.3.2",
        "socket.io-msgpack-parser": "^3.0.1"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "printWidth": 140,
        "semi": true,
        "trailingComma": "none"
    },
    "babel": {
        "plugins": [
            [
                "@babel/plugin-proposal-decorators",
                {
                    "legacy": true
                }
            ]
        ],
        "presets": [
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                },
                "@babel/preset-typescript"
            ]
        ],
        "ignore": [
            "**/cocos2d-js-for-preview.js"
        ]
    },
    "activationEvents": [
        "workspaceContains:node_modules/.bin/jest"
    ],
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "pre-push": "yarn test"
        }
    }
}
